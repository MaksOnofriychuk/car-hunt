# --- База даних (Neon / Supabase) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Автентифікація (двоє користувачів, без реєстрації) ---
APP_PASSWORD=""
USER_ME_NAME=""
USER_DAD_NAME=""
# Ключ для підпису cookie сесії: openssl rand -hex 32
SESSION_SECRET=""

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID_ME=""
TELEGRAM_CHAT_ID_DAD=""
TELEGRAM_WEBHOOK_SECRET=""

# --- Cron (Authorization: Bearer ${CRON_SECRET}) ---
CRON_SECRET=""

# --- Публічна адреса застосунку (посилання на картки в Telegram) ---
APP_URL="http://localhost:3000"

# --- Сховище файлів (копії фото оголошень) ---
# auto = r2, якщо задані ключі нижче, інакше локальна папка /storage
STORAGE_DRIVER="auto"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# публічний домен бакета; порожньо — роздаємо через /api/files/[...key]
R2_PUBLIC_URL=""

# --- Парсер AUTO.RIA ---
# api = developers.ria.com (потрібен ключ), html = парсинг сторінки оголошення
PARSER_SOURCE="html"
RIA_API_KEY=""
