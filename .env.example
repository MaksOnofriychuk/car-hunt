# --- База даних (Neon / Supabase) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Автентифікація (двоє користувачів, без реєстрації) ---
APP_PASSWORD=""
USER_ME_NAME=""
USER_DAD_NAME=""
# Ключ для підпису cookie сесії й посилань на фото в Telegram: openssl rand -hex 32
SESSION_SECRET=""

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID_ME=""
TELEGRAM_CHAT_ID_DAD=""
TELEGRAM_WEBHOOK_SECRET=""
# Скільки чекати решту альбому, мс. Telegram шле його кількома апдейтами.
TELEGRAM_ALBUM_DELAY_MS="3000"

# --- Cron (Authorization: Bearer ${CRON_SECRET}) ---
CRON_SECRET=""

# --- Публічна адреса застосунку ---
# Посилання на картки і фото в повідомленнях бота. На localhost Telegram їх не
# бачить: посилання не стане посиланням, фото не завантажиться (docs/telegram.md).
APP_URL="http://localhost:3000"

# --- Сховище файлів (копії фото оголошень) ---
# auto = r2, якщо задані ключі нижче, інакше локальна папка /storage
STORAGE_DRIVER="auto"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# публічний домен бакета; порожньо — роздаємо через /api/files/[...key]
R2_PUBLIC_URL=""

# --- Парсер AUTO.RIA ---
# Пошта в User-Agent вихідних запитів. Опційно, але це ввічливо.
CONTACT_EMAIL=
# api = developers.ria.com (потрібен ключ), html = парсинг сторінки оголошення
PARSER_SOURCE="html"
RIA_API_KEY=""

# --- Курс долара ---
# Основне джерело — НБУ (без ключа), курс кешується в таблиці exchange_rates.
# Цей рядок потрібен лише як запасний, якщо НБУ недоступний на першому запуску.
USD_UAH_RATE=
